# Supabase 프로젝트 설정 (Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 이메일 알림 (선택, Resend 사용 시)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# 배포된 서비스의 절대 URL (예: https://your-project.vercel.app)
# 예약 링크 공유 시 절대경로 생성에 사용
NEXT_PUBLIC_APP_URL=http://localhost:3000
